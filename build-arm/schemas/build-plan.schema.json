{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perian.dev/schemas/build-plan.schema.json",
  "title": "Build Plan",
  "description": "Coder's executable plan derived from product-plan.",
  "type": "object",
  "required": ["job_id", "steps", "expected_artifacts"],
  "properties": {
    "job_id": {"type": "string"},
    "drafted_at": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "what"],
        "properties": {
          "index": {"type": "integer"},
          "what": {"type": "string"},
          "expected_outcome": {"type": "string"}
        }
      },
      "minItems": 1
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "expected_artifacts": {"type": "array", "items": {"type": "string"}},
    "tool_calls_outline": {"type": "array", "items": {"type": "string"}}
  }
}
